      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH deleted AS (\n  DELETE FROM documents\n  WHERE metadata->>'file_id' = $1\n  RETURNING 1\n)\nSELECT count(*) AS deleted_chunks FROM deleted;",
        "options": {
          "queryReplacement": "={{ $json.fileId }}"
        }
      },
